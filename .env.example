# Neon connection string (Dashboard -> Connect). Never commit the real value.
DATABASE_URL=
# Password for /admin. Use a long random value.
ADMIN_PASSWORD=
# Random string (32+ chars) used to sign the admin session cookie.
ADMIN_SECRET=
# Public demo: "true" adds a one-click admin login, masks contacts and adds sample bookings.
# Leave empty for a real salon.
DEMO_MODE=
