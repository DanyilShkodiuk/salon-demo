# Neon connection string (Dashboard -> Connect). Never commit the real value.
DATABASE_URL=
# Password for /admin. Use a long random value.
ADMIN_PASSWORD=
# Random string (32+ chars) used to sign the admin session cookie.
ADMIN_SECRET=
# Optional: email the owner (and the customer, if they left an email) on each new booking.
# Leave empty to skip emails. Get a key at resend.com -> API Keys.
RESEND_API_KEY=
# Sender, on a domain verified in Resend. For a quick test use: Luna Hair Studio <onboarding@resend.dev>
NOTIFY_FROM=
# Where new-booking alerts go (the salon owner's inbox).
NOTIFY_OWNER_EMAIL=
